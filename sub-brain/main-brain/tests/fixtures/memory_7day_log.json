    {
      "query": "M6a 是什么",
      "expects": ["day1-bug-fix"]
    },
    {
      "query": "用户对人生意义的看法",
      "expects": ["day4-question-life", "day4-followup-life"]
    },
    {
      "query": "用户最近改了什么习惯",
      "expects": ["day1-coffee-change"]
    }
  ]
