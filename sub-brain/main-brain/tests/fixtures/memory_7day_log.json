    },
    {
      "query": "为什么不用 Qdrant",
      "expects": ["day5-decision-store"]
    },
    {
      "query": "用户最近在喝什么茶",
      "expects": ["day4-tea-mention"]
    },
    {
      "query": "用户什么时候去杭州",
      "expects": ["day3-plan-trip", "day3-plan-meeting"]
    },
    {
      "query": "杭州住哪个酒店",
      "expects": ["day3-plan-hotel", "day3-plan-meeting"]
    },
    {
      "query": "WeBrain 的中期目标",
      "expects": ["day2-goal-product"]
    },
    {
      "query": "桌面端什么时候做出来",
      "expects": ["day2-goal-deploy"]
    },
    {
      "query": "团队规模",
      "expects": ["day2-goal-team"]
    },
    {
      "query": "skill 执行的安全问题",
      "expects": ["day1-bug-skill", "day1-bug-fix"]
