  "queries": [
    {
      "query": "用户叫什么名字",
      "expects": ["day7-intro-name"],
      "note": "Basic identity recall — should work whether or not consolidation ran."
    },
    {
      "query": "用户住在哪里",
      "expects": ["day7-intro-city"]
    },
    {
      "query": "用户在做什么项目",
      "expects": ["day7-intro-work", "day7-intro-tech"]
    },
    {
      "query": "用户用什么后端技术栈",
      "expects": ["day7-intro-tech"]
    },
    {
      "query": "用户的咖啡偏好",
      "expects": ["day6-coffee-1", "day1-coffee-change"],
      "note": "Tests conflict-resolution recall — both the original and updated preference should be retrievable; whoever is `current` decides which the assistant defaults to."
    },
    {
      "query": "用户喜欢用什么主题",
      "expects": ["day6-darkmode"]
    },
    {
      "query": "用户的作息时间",
      "expects": ["day6-bedtime"]
    },
    {
      "query": "RAG 模块代码在哪",
